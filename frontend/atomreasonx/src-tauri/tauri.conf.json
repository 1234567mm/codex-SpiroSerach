{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AtomReasonX",
  "version": "0.1.0",
  "identifier": "com.atomreasonx.atomx",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AtomReasonX \u2014 AtomX Materials Discovery Agent",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* http://[::1]:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [
      "binaries/spiroctl"
    ],
    "copyright": "AtomReasonX",
    "category": "DeveloperTool",
    "shortDescription": "Reason at Atomic Scale, Build Beyond Materials.",
    "longDescription": "AtomReasonX \u2014 a configurable perovskite materials screening agent platform with local-first, auditable, contract-driven workflows.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGNDM5REU4MEE3RjY5Q0YKUldUUGFYOEs2SjFEejhNK08yTzh1QjZwUlFJK3pMazhuOG1aVlpVMkE4NGpNN2FXd2FPbHNxakoK",
      "endpoints": [
        "https://github.com/1234567mm/codex-SpiroSerach/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
