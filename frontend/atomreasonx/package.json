{
  "name": "atomreasonx-atomx-workbench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:fmt": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/invoke-msvc-cargo.ps1 -RepositoryRoot ../.. -WorkingDirectory frontend/atomreasonx/src-tauri fmt --check",
    "tauri:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/invoke-msvc-cargo.ps1 -RepositoryRoot ../.. -WorkingDirectory frontend/atomreasonx/src-tauri test --offline",
    "sidecar:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-atomreasonx-spiroctl-sidecar.ps1 -RepositoryRoot ../..",
    "sidecar:check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/check-atomreasonx-sidecar-packaging.ps1 -RepositoryRoot ../.. -RequireBundledSidecar",
    "tauri:build:app": "npm run sidecar:build && npm run sidecar:check && powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/invoke-msvc-cargo.ps1 -RepositoryRoot ../.. -WorkingDirectory frontend/atomreasonx -CommandName .\\node_modules\\.bin\\tauri.cmd build --no-bundle",
    "tauri:build": "npm run sidecar:build && npm run sidecar:check && powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/invoke-msvc-cargo.ps1 -RepositoryRoot ../.. -WorkingDirectory frontend/atomreasonx -CommandName .\\node_modules\\.bin\\tauri.cmd build"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
