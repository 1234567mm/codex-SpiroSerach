{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spirosearch.local/schemas/source-snapshot-manifest.schema.json",
  "title": "SourceSnapshotManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "dataset_doi",
    "dataset_version",
    "retrieved_at",
    "source_url",
    "license_hint",
    "required_citation",
    "files",
    "importer",
    "normalized_record_count",
    "quarantine_status"
  ],
  "properties": {
    "schema_version": { "const": "v35.source_snapshot_manifest.v1" },
    "source_id": { "type": "string", "minLength": 1 },
    "dataset_doi": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "retrieved_at": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "minLength": 1 },
    "license_hint": { "type": "string", "minLength": 1 },
    "required_citation": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/snapshot_file" }
    },
    "importer": { "$ref": "#/$defs/importer" },
    "normalized_record_count": { "type": "integer", "minimum": 0 },
    "quarantine_status": {
      "enum": [
        "ready",
        "fixture_only",
        "pending_import",
        "quarantined",
        "local_only"
      ]
    },
    "closure_evidence": { "$ref": "#/$defs/closure_evidence" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "snapshot_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "bytes", "sha256", "role"],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!file://)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "role": {
          "enum": [
            "raw_search",
            "raw_archive",
            "normalized_records",
            "data_dictionary",
            "license",
            "attribution",
            "validation_summary"
          ]
        }
      }
    },
    "closure_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "v35.source_closure_evidence.v1" },
        "parser_name": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string", "minLength": 1 },
        "unit_system": { "type": "string", "minLength": 1 },
        "checksum_policy": { "type": "string", "minLength": 1 },
        "license_review": { "type": "string", "minLength": 1 },
        "citation_review": { "type": "string", "minLength": 1 },
        "python_oracle_report": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!file://)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
        },
        "parser_parity_report": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!file://)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
        },
        "record_parser_report": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!file://)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
        },
        "unit_validation_report": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!file://)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
        },
        "record_license_review": { "type": "string", "minLength": 1 }
      }
    },
    "importer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "normalizer_version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "normalizer_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
